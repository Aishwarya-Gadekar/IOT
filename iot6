#!/usr/bin/env python3

# Install:
# pip3 install adafruit-circuitpython-dht paho-mqtt gpiozero

import time
import json
import board
import adafruit_dht
import paho.mqtt.client as mqtt

from gpiozero import LED

THRESHOLD = 30.0
BROKER = "broker.hivemq.com"
TOPIC = "iotlab/edge/dht11"

dht = adafruit_dht.DHT11(board.D4)
led = LED(17)

client = mqtt.Client(
    mqtt.CallbackAPIVersion.VERSION2
)

client.connect(BROKER, 1883, 60)
client.loop_start()

total = sent = 0

print("Edge node started")

try:
    while True:
        try:
            t = float(dht.temperature)
            h = float(dht.humidity)

        except (RuntimeError, TypeError):
            time.sleep(2)
            continue

        total += 1
        stamp = time.strftime("%H:%M:%S")

        if t > THRESHOLD:
            led.on()

            payload = json.dumps({
                "temp": t,
                "hum": h,
                "alert": True
            })

            client.publish(TOPIC, payload)
            sent += 1

            print(f"[{stamp}] T={t:.1f}C H={h:.0f}% -> ALERT! LED ON")

            print("Published to cloud:", payload)

        else:
            led.off()

            print(f"[{stamp}] T={t:.1f}C H={h:.0f}% -> normal, not transmitted")

        time.sleep(2)

except KeyboardInterrupt:

    saved = 100 * (total - sent) // max(total, 1)

    print("Stopped.")
    print("Readings:", total)
    print("Transmitted:", sent)
    print("Suppressed:", total - sent)
    print("Traffic reduction:", saved, "%")

finally:
    led.off()
    dht.exit()
    client.loop_stop()
    client.disconnect()
